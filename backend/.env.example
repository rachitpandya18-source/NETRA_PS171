APP_NAME=NETRA Backend
VERSION=1.0.0
ENVIRONMENT=demo
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# deterministic = no remote model required
# hybrid = VLM first, deterministic fallback
# vlm = require VLM; no fallback
PLANNER_MODE=hybrid
ALLOW_FALLBACK=true

VLM_ENABLED=false
VLM_BASE_URL=http://localhost:11434/v1
VLM_API_KEY=local
VLM_MODEL=qwen-vl
VLM_TIMEOUT_S=45

MAX_IMAGE_BYTES=8388608
MAX_NODES=3000
MAX_INSTRUCTION_CHARS=1000
PRIVACY_STRICT=true
AUDIT_KEEP=500
