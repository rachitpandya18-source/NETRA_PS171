{
  "manifest_version": 3,
  "name": "NETRA — Privacy-First Browser Agent",
  "version": "0.1.0",
  "description": "NETRA working demo: local UI perception, local PII redaction, sanitized planning and safe browser actions.",
  "permissions": ["activeTab", "tabs", "storage", "sidePanel"],
  "host_permissions": ["http://localhost/*", "https://localhost/*", "<all_urls>"],
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Open NETRA"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}